# Public, shown on the site (safe in the browser)
# Which storefront to build: incredible (default) or authentic
VITE_BRAND=incredible
VITE_BUSINESS_NAME=Incredible UP
VITE_CONTACT_EMAIL=hello@yourdomain.in
VITE_WHATSAPP=919876543210
VITE_PHONE=+919876543210
VITE_BUSINESS_ADDRESS=Varanasi, Uttar Pradesh, India
VITE_GRIEVANCE_OFFICER=
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only. Set these in Vercel > Settings > Environment Variables, never commit them
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ENQUIRY_TO=hello@yourdomain.in
ENQUIRY_FROM=Incredible UP <enquiries@yourdomain.in>

# Search and sharing (optional, all public)
# Address search engines should treat as the real site; authenticup.in is built in
VITE_SITE_URL=
# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ
VITE_GA_ID=
# Codes from Google Search Console / Bing Webmaster Tools, if verifying by HTML tag
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
# Comma-separated profile links (Instagram, Facebook, YouTube...) for search results
VITE_SOCIAL_LINKS=
